CREATE SCHEMA PUBLIC AUTHORIZATION DBA
CREATE MEMORY TABLE PUBLIC.CITA(CITAID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL PRIMARY KEY,DESCRIPCION VARCHAR(200),ESTADO VARCHAR(255),FECHACITA DATE,HORACITA VARCHAR(8),MOTIVOCANCELACION VARCHAR(200),MEDICO_MEDICOID INTEGER,PACIENTE_CEDULA VARCHAR(10))
ALTER TABLE PUBLIC.CITA ALTER COLUMN CITAID RESTART WITH 6
CREATE MEMORY TABLE PUBLIC.DIAGNOSTICO(DIAGNOSTICOID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL PRIMARY KEY,DESCRIPCION VARCHAR(500),FECHAREVISION DATE,OBSERVACIONESCLINICAS VARCHAR(500),TRATAMIENTO VARCHAR(500),CITA_CITAID INTEGER,PACIENTE_CEDULA VARCHAR(10),CONSTRAINT FKB1WBVBLMJL8P7KMA3MT6C58BF FOREIGN KEY(CITA_CITAID) REFERENCES PUBLIC.CITA(CITAID))
ALTER TABLE PUBLIC.DIAGNOSTICO ALTER COLUMN DIAGNOSTICOID RESTART WITH 2
CREATE MEMORY TABLE PUBLIC.IMAGES(ID VARCHAR(32) NOT NULL PRIMARY KEY,GALLERY VARCHAR(32),IMAGE VARBINARY(16777216))
CREATE MEMORY TABLE PUBLIC.MEDICO(MEDICOID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL PRIMARY KEY,APELLIDO VARCHAR(100),CORREOELECTRONICO VARCHAR(100),EDAD INTEGER NOT NULL,ESPECIALIDAD VARCHAR(100),NOMBRE VARCHAR(100),REGISTROPROFESIONAL VARCHAR(50),TELEFONO VARCHAR(15))
ALTER TABLE PUBLIC.MEDICO ALTER COLUMN MEDICOID RESTART WITH 7
CREATE MEMORY TABLE PUBLIC.OXDISCUSSIONCOMMENTS(ID VARCHAR(32) NOT NULL PRIMARY KEY,COMMENT CLOB(16M),DISCUSSIONID VARCHAR(32),TIME TIMESTAMP,USERNAME VARCHAR(30))
CREATE INDEX IDXBHLX4VUNN24YM1TBRLGQ8G30M ON PUBLIC.OXDISCUSSIONCOMMENTS(DISCUSSIONID)
CREATE MEMORY TABLE PUBLIC.PACIENTE(CEDULA VARCHAR(10) NOT NULL PRIMARY KEY,ALERGIAS VARCHAR(200),APELLIDO VARCHAR(100),CONDICIONESPECIAL VARCHAR(200),CORREOELECTRONICO VARCHAR(100),DIRECCION VARCHAR(200),FECHANACIMIENTO DATE,GENERO VARCHAR(255),NOMBRE VARCHAR(100),TELEFONO VARCHAR(15))
CREATE MEMORY TABLE PUBLIC.USUARIO(USUARIOID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL PRIMARY KEY,PASSWORD VARCHAR(100),ROL VARCHAR(255),USERNAME VARCHAR(50),MEDICO_MEDICOID INTEGER,CONSTRAINT UK_471I15K6VBJ1LFSFB19GETCDI UNIQUE(USERNAME),CONSTRAINT FKA7FTNSWIOXUXLQI53MQM1SCOR FOREIGN KEY(MEDICO_MEDICOID) REFERENCES PUBLIC.MEDICO(MEDICOID))
ALTER TABLE PUBLIC.USUARIO ALTER COLUMN USUARIOID RESTART WITH 1
